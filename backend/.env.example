# ==============================================================================
# Bapat Optics Luxury API - Environment Configuration Template
# Copy this file to .env and replace placeholder values with your credentials.
# NEVER commit real credentials to version control.
# ==============================================================================

# Database Connection (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./bapat_local.db
# DATABASE_URL=postgresql://user:password@ep-host.aws.neon.tech/neondb?sslmode=require

# Application Secrets
SECRET_KEY=change-this-to-a-secure-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
MOCK_PAYMENTS=true
RAZORPAY_CURRENCY=INR

# CORS Allowed Origins (comma-separated URLs)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Official Contact & Business
BAPAT_WHATSAPP_NUMBER=+919175586133
BAPAT_OFFICIAL_EMAIL=bapatopticsonline@gmail.com

# Initial Admin & Staff Credentials
ADMIN_EMAIL=admin@bapatoptics.com
ADMIN_PASSWORD=change-admin-password
OPTOMETRIST_EMAIL=optometrist@bapatoptics.com
OPTOMETRIST_PASSWORD=change-optometrist-password

# Email / SMTP Settings
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-google-app-password
MAIL_FROM=bapatopticsonline@gmail.com

# Commerce Policies & Providers
SHIPPING_PROVIDER=manual
SHIPPING_FLAT_RATE=0
ANALYTICS_PROVIDER=none
GST_PERCENT=18
FREE_SHIPPING_THRESHOLD=5000
RETURN_WINDOW_DAYS=7
